# Gnani Prisma v2.5 speech-to-text API key.
# Get one from https://app.gnani.ai/voice/ then copy this file to .env
# Never commit the real .env file - it is git-ignored.
GNANI_API_KEY=

# Mistral LLM integration (optional; both features are OFF by default).
# Get a key from https://console.mistral.ai/ and copy this file to .env
# Never commit the real .env file - it is git-ignored.
MISTRAL_API_KEY=
# Optional overrides (defaults shown):
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT_SECONDS=10
# Feature flags - leave unset/0 to keep the deterministic providers:
MISTRAL_AE_ENABLED=0
MISTRAL_MI_ENABLED=0
